{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Home Command",
  "version": "0.1.3",
  "identifier": "com.shcm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart Home Command",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 480,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "overlay",
        "title": "Smart Home Overlay",
        "url": "index.html?view=overlay",
        "width": 480,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": "D3FEA3DFD3CD035A2BF603E1E558037A459F7223",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
